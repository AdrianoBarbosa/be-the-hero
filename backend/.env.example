PORT=3333
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Aceita segundos (3600) ou unidades (1h, 1d).
JWT_EXPIRES_IN=1d
# Origens permitidas, separadas por vírgula. Vazio libera todas.
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT=10
# Número de proxies reversos na frente da API (ex.: 1). Vazio desativa.
TRUST_PROXY=
